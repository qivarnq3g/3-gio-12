{
  "name": "threetwelve-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../docs/api/openapi.yaml -o src/api/schema.d.ts",
    "predev": "npm run gen:api",
    "dev": "vite",
    "prebuild": "npm run gen:api",
    "build": "tsc -b && vite build",
    "pretest": "npm run gen:api",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
